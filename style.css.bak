@import url('https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@300;400;600;700&family=Cinzel:wght@400;600;700&display=swap');

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --gold:        #c9a84c;
  --gold-light:  #e8c97a;
  --gold-dim:    #7a6130;
  --red-light:   #d44040;
  --bg:          #07070f;
  --bg2:         #0e0e1c;
  --text:        #d8ceb8;
  --text-dim:    #7a7260;
  --glow-gold:   rgba(201,168,76,0.18);
  --glow-red:    rgba(176,48,48,0.18);

  /* グレード別カラー */
  --c-special:  #e8c97a;
  --c-maxlucky: #c0392b;
  --c-great:    #d44040;
  --c-good:     #ffffff;
  --c-trial:    #5b8dd9;
}

html { scroll-behavior: smooth; }

body {
  background: var(--bg);
  color: var(--text);
  font-family: 'Noto Serif JP', 'YuMincho', serif;
  min-height: 100vh;
  overflow-x: hidden;
}

body::before {
  content: '';
  position: fixed;
  inset: 0;
  background-image:
    radial-gradient(1px 1px at 10% 15%, rgba(201,168,76,0.4) 0%, transparent 100%),
    radial-gradient(1px 1px at 25% 60%, rgba(255,255,255,0.15) 0%, transparent 100%),
    radial-gradient(1px 1px at 40% 30%, rgba(201,168,76,0.3) 0%, transparent 100%),
    radial-gradient(1px 1px at 55% 80%, rgba(255,255,255,0.1) 0%, transparent 100%),
    radial-gradient(1px 1px at 70% 20%, rgba(201,168,76,0.25) 0%, transparent 100%),
    radial-gradient(1px 1px at 80% 55%, rgba(255,255,255,0.15) 0%, transparent 100%),
    radial-gradient(1.5px 1.5px at 85% 85%, rgba(201,168,76,0.3) 0%, transparent 100%),
    radial-gradient(2px 2px at 50% 10%, rgba(201,168,76,0.5) 0%, transparent 100%),
    radial-gradient(2px 2px at 95% 70%, rgba(201,168,76,0.4) 0%, transparent 100%);
  pointer-events: none;
  z-index: 0;
}

/* ===== ヘッダー ===== */
header {
  position: relative;
  text-align: center;
  padding: 60px 20px 40px;
  z-index: 1;
}

.logo-wrap { display: inline-block; position: relative; }

.logo-wrap::before {
  content: '';
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 180px; height: 180px;
  border-radius: 50%;
  border: 1px solid var(--gold-dim);
  box-shadow: 0 0 30px var(--glow-gold), inset 0 0 30px var(--glow-gold);
  animation: ring-spin 20s linear infinite;
  pointer-events: none;
}

.logo-wrap::after {
  content: '';
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 140px; height: 140px;
  border-radius: 50%;
  border: 1px solid rgba(201,168,76,0.2);
  animation: ring-spin 14s linear infinite reverse;
  pointer-events: none;
}

@keyframes ring-spin {
  from { transform: translate(-50%, -50%) rotate(0deg); }
  to   { transform: translate(-50%, -50%) rotate(360deg); }
}

.logo {
  font-family: 'Cinzel', serif;
  font-size: clamp(3rem, 8vw, 5rem);
  font-weight: 700;
  color: var(--gold);
  letter-spacing: 0.15em;
  text-shadow: 0 0 20px rgba(201,168,76,0.5), 0 0 60px rgba(201,168,76,0.2);
  position: relative;
  z-index: 1;
  line-height: 1;
  padding: 40px 20px;
}

.tagline {
  font-size: 1.1rem;
  color: var(--text-dim);
  letter-spacing: 0.3em;
  margin-top: 12px;
}

.divider {
  width: 100%;
  max-width: 400px;
  margin: 32px auto;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--gold-dim), transparent);
  position: relative;
}

.divider::before {
  content: '✦';
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  color: var(--gold);
  font-size: 0.8rem;
  background: var(--bg);
  padding: 0 8px;
}

/* ===== メイン ===== */
main {
  position: relative;
  z-index: 1;
  max-width: 700px;
  margin: 0 auto;
  padding: 0 20px 80px;
}

/* ===== フォーム ===== */
.form-section {
  background: var(--bg2);
  border: 1px solid var(--gold-dim);
  border-radius: 2px;
  padding: 40px;
  box-shadow: 0 0 40px rgba(0,0,0,0.5), inset 0 0 40px rgba(201,168,76,0.03);
  position: relative;
}

.form-section::before, .form-section::after, .corner-tr, .corner-bl {
  content: '';
  position: absolute;
  width: 16px; height: 16px;
  border-color: var(--gold);
  border-style: solid;
}
.form-section::before { top: 8px; left: 8px;    border-width: 1px 0 0 1px; }
.form-section::after  { top: 8px; right: 8px;   border-width: 1px 1px 0 0; }
.corner-tr            { bottom: 8px; right: 8px; border-width: 0 1px 1px 0; }
.corner-bl            { bottom: 8px; left: 8px;  border-width: 0 0 1px 1px; }

.form-title {
  font-size: 1rem;
  color: var(--gold);
  letter-spacing: 0.25em;
  text-align: center;
  margin-bottom: 32px;
}

.input-group { margin-bottom: 24px; }

.input-group label {
  display: block;
  font-size: 0.75rem;
  color: var(--gold-dim);
  letter-spacing: 0.3em;
  margin-bottom: 8px;
}

.input-group input {
  width: 100%;
  background: var(--bg);
  border: 1px solid var(--gold-dim);
  border-radius: 1px;
  color: var(--gold-light);
  font-family: 'Noto Serif JP', serif;
  font-size: 1.4rem;
  padding: 14px 18px;
  outline: none;
  transition: border-color 0.3s, box-shadow 0.3s;
  letter-spacing: 0.15em;
}

.input-group input::placeholder { color: var(--text-dim); font-size: 0.9rem; letter-spacing: 0.1em; }
.input-group input:focus { border-color: var(--gold); box-shadow: 0 0 16px var(--glow-gold); }

.submit-btn {
  width: 100%;
  margin-top: 8px;
  padding: 16px;
  background: transparent;
  border: 1px solid var(--gold);
  color: var(--gold);
  font-family: 'Cinzel', serif;
  font-size: 1rem;
  font-weight: 600;
  letter-spacing: 0.3em;
  cursor: pointer;
  transition: all 0.3s;
  position: relative;
  overflow: hidden;
}

.submit-btn::before {
  content: '';
  position: absolute;
  inset: 0;
  background: var(--gold);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.3s;
  z-index: 0;
}
.submit-btn:hover::before { transform: scaleX(1); }
.submit-btn:hover { color: var(--bg); }
.submit-btn span { position: relative; z-index: 1; }

/* ===== 結果エリア ===== */
#result-area {
  margin-top: 40px;
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 0.6s ease, transform 0.6s ease;
  pointer-events: none;
}
#result-area.visible {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

#result-area.visible .name-chart {
  animation: chart-reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

/* ===== 全体グレード ===== */
.result-top {
  text-align: center;
  margin-bottom: 32px;
}

.overall-badge {
  display: inline-block;
  font-family: 'Cinzel', serif;
  font-size: 1.3rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  padding: 8px 28px;
  border: 1px solid;
  margin-bottom: 12px;
}

.overall-badge.special {
  color: #fff;
  border-color: rgba(255,255,255,0.6);
  box-shadow: 0 0 30px rgba(255,255,255,0.2), 0 0 60px var(--glow-gold);
  animation: special-pulse 2s ease-in-out infinite;
}
@keyframes special-pulse {
  0%,100% { box-shadow: 0 0 30px rgba(255,255,255,0.2), 0 0 60px var(--glow-gold); }
  50%      { box-shadow: 0 0 50px rgba(255,255,255,0.35), 0 0 80px rgba(201,168,76,0.3); }
}

/* ゴールドシマー（下から上） */
@keyframes gold-shimmer {
  0%   { background-position: center -200%; }
  100% { background-position: center 200%; }
}

/* 赤シマー（下から上） */
@keyframes red-shimmer {
  0%   { background-position: center -200%; }
  100% { background-position: center 200%; }
}

/* シマー対象にGPUヒント */
.kaku-box.special .kaku-box-num,
.kaku-box.maxlucky .kaku-box-num,
.kaku-card.special .kaku-card-num,
.kaku-card.maxlucky .kaku-card-num,
.kaku-box-badge.special,
.kaku-box-badge.maxlucky {
  will-change: background-position;
}

/* 浮遊パーティクル */
@keyframes float-particle {
  0%   { transform: translateY(0) translateX(0) scale(1);   opacity: 0; }
  10%  { opacity: 1; }
  50%  { transform: translateY(-45vh) translateX(20px) scale(1.2); opacity: 0.7; }
  90%  { opacity: 0.3; }
  100% { transform: translateY(-95vh) translateX(-10px) scale(0.5); opacity: 0; }
}

.magic-particle {
  position: fixed;
  width: 3px;
  height: 3px;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
  animation: float-particle linear infinite;
  will-change: transform, opacity;
}

/* 星きらめき */
@keyframes star-twinkle {
  0%,100% { opacity: 0.4; transform: scale(1); }
  50%      { opacity: 1;   transform: scale(1.6); }
}

.magic-star {
  position: fixed;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
  animation: star-twinkle ease-in-out infinite;
  will-change: transform, opacity;
}

/* 結果出現：魔法陣展開 */
@keyframes chart-reveal {
  0%   { opacity: 0; transform: scale(0.88); }
  60%  { transform: scale(1.02); }
  100% { opacity: 1; transform: scale(1); }
}

/* キラン：中心閃光 */
@keyframes kiran-core {
  0%   { transform: translate(-50%,-50%) scale(0); opacity: 1; }
  60%  { opacity: 0.9; }
  100% { transform: translate(-50%,-50%) scale(1); opacity: 0; }
}

/* キラン：十字光 */
@keyframes kiran-ray-h {
  0%   { transform: translate(-50%,-50%) scaleX(0); opacity: 1; }
  50%  { opacity: 0.8; }
  100% { transform: translate(-50%,-50%) scaleX(1); opacity: 0; }
}
@keyframes kiran-ray-v {
  0%   { transform: translate(-50%,-50%) scaleY(0); opacity: 1; }
  50%  { opacity: 0.8; }
  100% { transform: translate(-50%,-50%) scaleY(1); opacity: 0; }
}

/* キラン：斜め光 */
@keyframes kiran-ray-d1 {
  0%   { transform: translate(-50%,-50%) rotate(45deg) scaleX(0); opacity: 0.7; }
  100% { transform: translate(-50%,-50%) rotate(45deg) scaleX(1); opacity: 0; }
}
@keyframes kiran-ray-d2 {
  0%   { transform: translate(-50%,-50%) rotate(-45deg) scaleX(0); opacity: 0.7; }
  100% { transform: translate(-50%,-50%) rotate(-45deg) scaleX(1); opacity: 0; }
}

/* キラン：散らばる粒子 */
@keyframes kiran-spark {
  0%   { transform: translate(0,0) scale(1); opacity: 1; }
  100% { transform: var(--tx) scale(0); opacity: 0; }
}

.kiran-wrap {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 10;
  overflow: hidden;
}

.kiran-core {
  position: absolute;
  top: 50%; left: 50%;
  width: 240px; height: 240px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.95) 0%, rgba(232,201,122,0.7) 30%, rgba(201,168,76,0.2) 60%, transparent 75%);
  animation: kiran-core 0.7s ease-out forwards;
}

.kiran-ray {
  position: absolute;
  top: 50%; left: 50%;
  border-radius: 999px;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.9), transparent);
}

.kiran-ray.h {
  width: 400px; height: 2px;
  animation: kiran-ray-h 0.6s ease-out forwards;
}
.kiran-ray.v {
  width: 2px; height: 300px;
  animation: kiran-ray-v 0.6s ease-out forwards;
}
.kiran-ray.d1 {
  width: 300px; height: 1.5px;
  animation: kiran-ray-d1 0.5s ease-out 0.05s forwards;
  opacity: 0;
}
.kiran-ray.d2 {
  width: 300px; height: 1.5px;
  animation: kiran-ray-d2 0.5s ease-out 0.05s forwards;
  opacity: 0;
}

.kiran-spark {
  position: absolute;
  top: 50%; left: 50%;
  width: 4px; height: 4px;
  border-radius: 50%;
  background: #fff;
  animation: kiran-spark 0.8s ease-out forwards;
}

/* ゴールドグロー点滅 */
@keyframes gold-glow-pulse {
  0%,100% { text-shadow: 0 0 10px rgba(232,201,122,0.6), 0 0 30px rgba(232,201,122,0.3), 0 0 60px rgba(201,168,76,0.2); }
  50%      { text-shadow: 0 0 20px rgba(255,230,100,0.9), 0 0 50px rgba(232,201,122,0.6), 0 0 80px rgba(201,168,76,0.4); }
}

/* 赤グロー点滅 */
@keyframes red-glow-pulse {
  0%,100% { text-shadow: 0 0 10px rgba(220,50,50,0.6), 0 0 30px rgba(192,57,43,0.4), 0 0 60px rgba(160,30,30,0.3); }
  50%      { text-shadow: 0 0 20px rgba(255,80,80,0.9), 0 0 50px rgba(220,50,50,0.7), 0 0 80px rgba(192,57,43,0.5); }
}
.overall-badge.maxlucky { color: var(--gold-light); border-color: var(--gold); box-shadow: 0 0 24px var(--glow-gold); }
.overall-badge.great    { color: var(--gold);       border-color: var(--gold); box-shadow: 0 0 16px var(--glow-gold); }
.overall-badge.good     { color: var(--gold);       border-color: var(--gold-dim); }
.overall-badge.trial    { color: #a06060;            border-color: #6a3a3a; }

.grade-desc {
  font-size: 0.85rem;
  color: var(--text-dim);
  letter-spacing: 0.08em;
  line-height: 1.7;
  max-width: 440px;
  margin: 0 auto;
}

/* ===== 名前チャート（enamae.net風） ===== */
.name-chart {
  display: grid;
  grid-template-areas:
    "gai sei ten"
    "gai jnt jin"
    "gai mei chi"
    ".   so  .  ";
  grid-template-columns: 1fr 80px 1fr;
  grid-template-rows: auto auto auto auto;
  gap: 16px 20px;
  align-items: center;
  justify-items: center;
  max-width: 480px;
  margin: 0 auto 32px;
  padding: 28px 16px;
  background: rgba(14,14,28,0.85);
  border: 1px solid rgba(201,168,76,0.2);
  position: relative;
}

/* 四隅装飾 */
.name-chart::before, .name-chart::after {
  content: '';
  position: absolute;
  width: 12px; height: 12px;
  border-color: var(--gold);
  border-style: solid;
}
.name-chart::before { top: 6px; left: 6px;   border-width: 1px 0 0 1px; }
.name-chart::after  { top: 6px; right: 6px;  border-width: 1px 1px 0 0; }

.nc-sei  { grid-area: sei; position: relative; }
.nc-ten  { grid-area: ten; }
.nc-gai  { grid-area: gai; align-self: stretch; display: flex; align-items: center; justify-content: center; position: relative; }
.nc-joint{ grid-area: jnt; position: relative; align-self: stretch; display: flex; align-items: center; justify-content: center; }
.nc-jin  { grid-area: jin; }
.nc-mei  { grid-area: mei; position: relative; }
.nc-chi  { grid-area: chi; }
.nc-so   { grid-area: so;  }

/* 格ブレース（どの文字が構成要素か視覚化） */
.nc-brace-r {
  position: absolute;
  writing-mode: horizontal-tb;
  right: -13px;
  top: 0; bottom: 0;
  width: 8px;
  border-top: 1px solid var(--gold-dim);
  border-right: 1px solid var(--gold-dim);
  border-bottom: 1px solid var(--gold-dim);
  border-radius: 0 3px 3px 0;
  pointer-events: none;
  z-index: 2;
}

/* 天格・地格ブレースは縦幅を詰める */
.nc-sei .nc-brace-r,
.nc-mei .nc-brace-r {
  width: 5px;
  right: -10px;
  top: 10px;
  bottom: 10px;
}


/* 外格用：左辺線で右に開く [ 形 */
.nc-brace-l {
  position: absolute;
  writing-mode: horizontal-tb;
  right: -13px;
  top: 0; bottom: 0;
  width: 8px;
  border-top: 1px solid var(--gold-dim);
  border-left: 1px solid var(--gold-dim);
  border-bottom: 1px solid var(--gold-dim);
  border-radius: 3px 0 0 3px;
  pointer-events: none;
  z-index: 2;
}

/* 縦書き名前 */
.nc-sei,
.nc-mei {
  writing-mode: vertical-rl;
  text-orientation: mixed;
  font-size: clamp(3rem, 7vw, 4.2rem);
  font-weight: 600;
  color: var(--gold-light);
  letter-spacing: 0.25em;
  text-shadow: 0 0 16px rgba(201,168,76,0.25);
  line-height: 1.2;
  text-align: center;
}

/* 人格コネクター（├形） */
.jin-connector {
  position: absolute;
  top: 0; bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 1px;
  background: linear-gradient(to bottom, transparent, var(--gold-dim) 15%, var(--gold-dim) 85%, transparent);
}

.jin-connector::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 0;
  width: 55px;
  height: 1px;
  background: linear-gradient(to right, var(--gold-dim), rgba(122,97,48,0.4));
}

/* 総格は中央寄せ */
.nc-so { justify-self: center; }

/* ===== 格ボックス ===== */
.kaku-box {
  text-align: center;
  padding: 10px 12px;
  border: 1px solid;
  border-radius: 2px;
  min-width: 80px;
  max-width: 130px;
  transition: box-shadow 0.3s;
  background: rgba(7,7,15,0.85);
}

.kaku-box.special  { border-color: rgba(232,201,122,0.5); box-shadow: 0 0 12px rgba(232,201,122,0.15); }
.kaku-box.maxlucky { border-color: rgba(192,57,43,0.5); }
.kaku-box.great    { border-color: rgba(212,64,64,0.4); }
.kaku-box.good     { border-color: rgba(255,255,255,0.2); }
.kaku-box.trial    { border-color: rgba(91,141,217,0.3); }

.kaku-box:hover.special  { box-shadow: 0 0 20px rgba(232,201,122,0.3); }
.kaku-box:hover.maxlucky { box-shadow: 0 0 20px rgba(192,57,43,0.3); }
.kaku-box:hover.great    { box-shadow: 0 0 16px rgba(212,64,64,0.25); }
.kaku-box:hover.good     { box-shadow: 0 0 16px rgba(255,255,255,0.1); }
.kaku-box:hover.trial    { box-shadow: 0 0 16px rgba(91,141,217,0.2); }

.kaku-box-label {
  font-size: 0.72rem;
  color: var(--text-dim);
  letter-spacing: 0.12em;
  margin-bottom: 6px;
  display: block;
}
.kaku-box-label ruby rt { font-size: 0.55rem; }

.kaku-box-num {
  font-family: 'Cinzel', serif;
  font-size: 2.2rem;
  font-weight: 700;
  line-height: 1;
  margin-bottom: 8px;
}

/* 特殊格・最大吉は一回り大きく */
.kaku-box.special .kaku-box-num,
.kaku-box.maxlucky .kaku-box-num {
  font-size: 2.8rem;
}

/* 総格は二回り大きく */
.nc-so .kaku-box-num {
  font-size: 3.2rem;
}

.kaku-box.special .kaku-box-num {
  background: linear-gradient(0deg, #a07820, #f5e175, #fffacd, #e8c97a, #f5e175, #a07820);
  background-size: auto 300%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: gold-shimmer 7s linear infinite, gold-glow-pulse 4s ease-in-out infinite;
}
.kaku-box.maxlucky .kaku-box-num {
  background: linear-gradient(0deg, #7a0000, #e03030, #ff6060, #e03030, #ff8080, #7a0000);
  background-size: auto 300%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: red-shimmer 7s linear infinite, red-glow-pulse 4s ease-in-out infinite;
}
.kaku-box.great    .kaku-box-num { color: var(--c-great);    text-shadow: 0 0 10px rgba(212,64,64,0.4); }
.kaku-box.good     .kaku-box-num { color: var(--c-good);     text-shadow: 0 0 8px rgba(255,255,255,0.2); }
.kaku-box.trial    .kaku-box-num { color: var(--c-trial); }

.kaku-box-badge {
  display: inline-block;
  font-size: 0.65rem;
  letter-spacing: 0.12em;
  padding: 2px 8px;
  border: 1px solid;
}

.kaku-box-badge.special  {
  background: linear-gradient(0deg, #a07820, #f5e175, #fffacd, #e8c97a, #a07820);
  background-size: auto 300%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: gold-shimmer 7s linear infinite;
  border-color: rgba(232,201,122,0.5);
}
.kaku-box-badge.maxlucky {
  background: linear-gradient(0deg, #7a0000, #e03030, #ff6060, #e03030, #7a0000);
  background-size: auto 300%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: red-shimmer 7s linear infinite;
  border-color: rgba(192,57,43,0.5);
}
.kaku-box-badge.great    { color: var(--c-great);    border-color: rgba(212,64,64,0.4); }
.kaku-box-badge.good     { color: var(--c-good);     border-color: rgba(255,255,255,0.25); }
.kaku-box-badge.trial    { color: var(--c-trial);    border-color: rgba(91,141,217,0.3); }

/* ===== 詳細解説セクション ===== */
.detail-divider {
  text-align: center;
  margin: 40px 0 24px;
  position: relative;
}

.detail-divider::before {
  content: '';
  position: absolute;
  top: 50%; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--gold-dim), transparent);
}

.detail-divider span {
  position: relative;
  background: var(--bg);
  padding: 0 16px;
  font-size: 0.8rem;
  color: var(--text-dim);
  letter-spacing: 0.2em;
}

/* ===== 五格詳細カード ===== */
.kaku-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.kaku-card:last-child { grid-column: 1 / -1; }

.kaku-card {
  background: rgba(14,14,28,0.8);
  border: 1px solid;
  border-radius: 2px;
  padding: 20px;
  transition: box-shadow 0.3s;
}

.kaku-card.special  { border-color: rgba(232,201,122,0.3); }
.kaku-card.maxlucky { border-color: rgba(192,57,43,0.4); }
.kaku-card.great    { border-color: rgba(212,64,64,0.3); }
.kaku-card.good     { border-color: rgba(255,255,255,0.15); }
.kaku-card.trial    { border-color: rgba(91,141,217,0.2); }

.kaku-card.special:hover  { box-shadow: 0 0 24px rgba(232,201,122,0.15); }
.kaku-card.maxlucky:hover { box-shadow: 0 0 24px rgba(192,57,43,0.2); }
.kaku-card.great:hover    { box-shadow: 0 0 20px rgba(212,64,64,0.2); }
.kaku-card.good:hover     { box-shadow: 0 0 20px rgba(255,255,255,0.08); }
.kaku-card.trial:hover    { box-shadow: 0 0 20px rgba(91,141,217,0.15); }

.kaku-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.kaku-card-label {
  font-size: 0.85rem;
  color: var(--text-dim);
  letter-spacing: 0.15em;
}
.kaku-card-label ruby rt { font-size: 0.55rem; color: var(--text-dim); }

.kaku-card-badge {
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  padding: 2px 10px;
  border: 1px solid;
}
.kaku-card-badge.special  { color: #e8c97a; border-color: rgba(232,201,122,0.5); }
.kaku-card-badge.maxlucky { color: #e03030; border-color: rgba(192,57,43,0.5); }
.kaku-card-badge.great    { color: var(--c-great);    border-color: rgba(212,64,64,0.4); }
.kaku-card-badge.good     { color: var(--c-good);     border-color: rgba(255,255,255,0.25); }
.kaku-card-badge.trial    { color: var(--c-trial);    border-color: rgba(91,141,217,0.3); }

.kaku-card-num {
  font-family: 'Cinzel', serif;
  font-size: 3rem;
  font-weight: 700;
  line-height: 1;
  margin-bottom: 10px;
}

.kaku-card.special .kaku-card-num,
.kaku-card.maxlucky .kaku-card-num {
  font-size: 3.8rem;
}
.kaku-card.special .kaku-card-num {
  background: linear-gradient(135deg, #a07820, #f5e175, #fffacd, #e8c97a);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  text-shadow: none;
  filter: drop-shadow(0 0 8px rgba(232,201,122,0.5));
}
.kaku-card.maxlucky .kaku-card-num {
  background: linear-gradient(135deg, #7a0000, #e03030, #ff6060);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  text-shadow: none;
  filter: drop-shadow(0 0 8px rgba(192,57,43,0.5));
}
.kaku-card.great    .kaku-card-num { color: var(--c-great);    text-shadow: 0 0 16px rgba(212,64,64,0.4); }
.kaku-card.good     .kaku-card-num { color: var(--c-good);     text-shadow: 0 0 10px rgba(255,255,255,0.2); }
.kaku-card.trial    .kaku-card-num { color: var(--c-trial); }

.kaku-card-detail {
  font-size: 0.72rem;
  color: var(--text-dim);
  margin-bottom: 10px;
  padding-bottom: 10px;
  border-bottom: 1px solid rgba(255,255,255,0.05);
  letter-spacing: 0.05em;
}

.kaku-card-desc {
  font-size: 0.75rem;
  color: var(--text-dim);
  margin-bottom: 8px;
  letter-spacing: 0.05em;
}

.kaku-card-meaning {
  font-size: 0.82rem;
  line-height: 1.7;
  letter-spacing: 0.05em;
}
.kaku-card.special  .kaku-card-meaning,
.kaku-card.maxlucky .kaku-card-meaning,
.kaku-card.great    .kaku-card-meaning,
.kaku-card.good     .kaku-card-meaning { color: var(--text); }
.kaku-card.trial    .kaku-card-meaning { color: #8a7a7a; }

/* ===== 注意表示 ===== */
.unknown-warning {
  background: rgba(176,48,48,0.1);
  border: 1px solid #6a3a3a;
  border-radius: 2px;
  padding: 12px 16px;
  font-size: 0.8rem;
  color: #a06060;
  margin-bottom: 20px;
  letter-spacing: 0.05em;
}

/* ===== X共有ボタン ===== */
.share-area { text-align: center; margin-bottom: 8px; }

.share-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 36px;
  background: transparent;
  border: 1px solid var(--gold-dim);
  color: var(--gold);
  font-family: 'Noto Serif JP', serif;
  font-size: 0.9rem;
  letter-spacing: 0.2em;
  cursor: pointer;
  transition: all 0.3s;
  position: relative;
  overflow: hidden;
}

.share-btn::before {
  content: '';
  position: absolute;
  inset: 0;
  background: var(--gold);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.3s;
  z-index: 0;
}
.share-btn:hover::before { transform: scaleX(1); }
.share-btn:hover { color: var(--bg); border-color: var(--gold); }
.share-btn > * { position: relative; z-index: 1; }
.share-icon { font-size: 1.1rem; font-weight: 700; }

/* ===== フッター ===== */
footer {
  position: relative;
  z-index: 1;
  text-align: center;
  padding: 32px 20px;
  border-top: 1px solid rgba(201,168,76,0.1);
}
footer p {
  font-family: 'Cinzel', serif;
  font-size: 0.7rem;
  color: var(--text-dim);
  letter-spacing: 0.3em;
}

/* ===== レスポンシブ ===== */
@media (max-width: 520px) {
  .form-section { padding: 28px 20px; }

  .name-chart {
    grid-template-columns: 1fr 60px 1fr;
    gap: 12px 12px;
    padding: 24px 12px;
  }

  .nc-sei, .nc-mei { font-size: 1.8rem; }

  .kaku-box { min-width: 64px; padding: 8px; }
  .kaku-box-num { font-size: 1.7rem; }
  .kaku-box-label { font-size: 0.65rem; }
  .kaku-box-badge { font-size: 0.6rem; padding: 1px 6px; }

  .kaku-grid { grid-template-columns: 1fr; }
  .kaku-card:last-child { grid-column: auto; }
  .kaku-card-num { font-size: 2.4rem; }
}
